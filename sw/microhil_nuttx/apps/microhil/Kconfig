#
# For a description of the syntax of this configuration file,
# see the file kconfig-language.txt in the NuttX tools repository.
#

config MICROHIL
	tristate "microHIL controller application"
	default n
	---help---
		Enable the microHIL controller application.

if MICROHIL

config MICROHIL_PROGNAME
	string "Program name"
	default "microhil"
	---help---
		This is the name of the program that will be used when the NSH ELF
		program is installed.

config MICROHIL_PRIORITY
	int "microHIL task priority"
	default 100

config MICROHIL_STACKSIZE
	int "microHIL stack size"
	default 2048

endif
